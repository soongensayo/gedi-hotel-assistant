# =============================================================================
# Copy to ".env" in this folder. Do not commit .env.
# Restart the Python app after edits (scanner reads most values at import time).
#
# LEGEND (image / OCR related):
#   [TUNABLE]     = numeric; change the value to tune behavior.
#   [ON/OFF]      = set 1, true, or yes to enable; omit, 0, or false = disabled
#                   (exact parsing is case-insensitive in code).
#   [ALIAS]       = alternate variable name; first non-empty wins (see comment).
#   [CODE ONLY]   = not an env var; behavior is fixed in Python (see bottom).
# =============================================================================


# -----------------------------------------------------------------------------
# Alignment crop — passport (always) & card (same order unless noted)
# Order in pipeline: gamma (passport) → brightness → contrast → saturation →
#   denoise → unsharp → then deskew / detection inside scanner.
# -----------------------------------------------------------------------------

# [TUNABLE float] Gamma on passport alignment crop. 1.0 = no gamma curve.
# SCAN_GAMMA=0.7

# [TUNABLE int] Brightness offset encoded as 0–255; 128 = zero offset (beta = value − 128 per BGR channel).
# [ALIAS] SCAN_GLOBAL_BRIGHTNESS, ADJUST_BRIGHTNESS (same meaning; first set wins).
# SCAN_BRIGHTNESS=125

# [TUNABLE int] Linear contrast ×100 (clamped ~50–200 in code). 100 = ×1.0 gain.
# [ALIAS] SCAN_GLOBAL_CONTRAST, ADJUST_CONTRAST
# SCAN_CONTRAST=160

# [TUNABLE int] HSV saturation scale ×100 (0–200 typical). 100 = unchanged; 0 ≈ grayscale chroma.
# [ALIAS] SCAN_SATURATION, ADJUST_SATURATION, or primary SCAN_PRE_SATURATION
# SCAN_PRE_SATURATION=100

# [TUNABLE int] Bilateral denoise strength 0–50. 0 = off (no filter).
# [ALIAS] SCAN_DENOISE, ADJUST_DENOISE
# SCAN_PRE_DENOISE=0

# [TUNABLE int] Morphological erosion kernel width 0–7 on the alignment crop. 0 = off.
# Useful when dark blobs connect adjacent MRZ characters; usually keep small (1–2).
# SCAN_PRE_ERODE=0

# [TUNABLE int] Morphological dilation kernel width 0–7 on the alignment crop. 0 = off.
# Useful when faint MRZ strokes are broken; usually keep small (1–2).
# SCAN_PRE_DILATE=0

# [TUNABLE int] Unsharp (median-based) on crop before deskew; 0–100, 0 = off.
# [ALIAS] SCAN_PREPROCESS_SHARPNESS
# SCAN_PRE_SHARPNESS=50

# [ON/OFF] Passport: use full camera frame instead of center PASSPORT_RECT (1040×640 box).
# SCAN_FULL_FRAME=0

# [ON/OFF] Card: also apply SCAN_GAMMA on card alignment crop (default: card skips gamma, only B/C + pre steps).
# SCAN_CARD_USE_GAMMA=0


# -----------------------------------------------------------------------------
# Deskew & detection (EasyOCR “master” image — LAB L channel CLAHE)
# -----------------------------------------------------------------------------

# [TUNABLE float] CLAHE clipLimit for EasyOCR detection master (MRZ strip deskew, MRZ line hunt, card deskew, PAN detect).
# SCAN_CLAHE_MASTER_CLIP=3.0

# [ON/OFF] Passport: estimate tilt and rotate **only the combined MRZ strip** (not the full page). Card: full-card deskew unchanged.
# Default if unset: ON. Set DESKEW_ENABLE=0 / false / off to disable.
# DESKEW_ENABLE=1

# [ON/OFF] After the first **MRZ strip** deskew (passport) or first card deskew in a batch, reuse the measured angle and
# skip the deskew EasyOCR readtext (only warpAffine). Passport cache key: passport_mrz. Default ON.
# DESKEW_CACHE_ANGLE=1

# [ON/OFF] After coarse Hough tilt on the **MRZ strip**, refine via row-projection on the full strip (passport MRZ only).
# Default ON. DESKEW_REFINE_HALF_DEG / DESKEW_REFINE_STEP_DEG tune search window and step (optional).
# DESKEW_REFINE_PASSPORT=1
# DESKEW_REFINE_HALF_DEG=2.2
# DESKEW_REFINE_STEP_DEG=0.2


# -----------------------------------------------------------------------------
# Variant OCR (per ROI: v1–v6 style stack; MRZ strip & card ROIs)
# -----------------------------------------------------------------------------

# [TUNABLE float] CLAHE clipLimit on LAB L for v5_lab_clahe / v6_lab_clahe only.
# SCAN_CLAHE_CLIP=2.5

# [TUNABLE int] Unsharp strength for variant v2 / v3 only (0–125). 0 = off. 100 ≈ strong (a=1.0); 125 = code max (a=1.25).
# [ALIAS] SCAN_SHARPNESS_VARIANT, ADJUST_SHARPNESS
# SCAN_VARIANT_SHARPNESS=50
# SCAN_VARIANT_SHARPNESS=125

# [TUNABLE int] Second unsharp pass on top of v2–v6 after the stack is built (0–125). 0 = off (default).
# Skips v1_orig so the raw baseline stays unchanged. [ALIAS] SCAN_VARIANT_EXTRA_SHARPNESS
# SCAN_VARIANT_SECOND_SHARPNESS=35

# [ON/OFF] Use v3 base (median blur + sharpen) for derived variants v4–v6 instead of v2 sharp only.
# Default if unset: OFF (v2-style base).
# OCR_USE_V3_BASE=0

# [TUNABLE float] Scale EasyOCR confidence for v5/v6 LAB CLAHE fragments in MRZ pool merge (0.05–1.5).
# Default 0.5 — reduces how often short junk from v5/v6 wins over long v1/v2 strings. Set 1.0 to disable.
# SCAN_MRZ_LAB_POOL_WEIGHT=0.5


# -----------------------------------------------------------------------------
# Camera & capture (hardware / input)
# -----------------------------------------------------------------------------

# [TUNABLE int] OpenCV camera index (0 = default webcam, 1 = first USB, …).
# CAMERA_INDEX=0


# -----------------------------------------------------------------------------
# Debug & diagnostics (not changing math, but what gets saved / logged)
# -----------------------------------------------------------------------------

# [ON/OFF] Save debug PNGs under debug/variants/ (passport/ & card/). Default if unset: OFF.
# DEBUG_ACTIVATE=0

# [ON/OFF] Log EasyOCR step durations to logger. Default if unset: OFF.
# OCR_TIMING=0


# -----------------------------------------------------------------------------
# Polling / gate (backend script; skips blurry frames before calling scanner)
# -----------------------------------------------------------------------------

# [TUNABLE float] Minimum Laplacian-variance “sharpness” to accept a frame (see backend/scripts/scan_passport_easyocr_poll.py).
# SHARPNESS_THRESHOLD=15


# -----------------------------------------------------------------------------
# EasyOCR models (paths / kill-switch)
# -----------------------------------------------------------------------------

# [PATH / STRING] Folder with craft_mlt_25k.pth and english_g2.pth (offline / edge).
# EASYOCR_MODULE_PATH=./easyocr_models

# [ON/OFF] Set to 1/true to disable EasyOCR entirely (mock / no-OCR paths).
# DISABLE_EASYOCR=0


# =============================================================================
# [CODE ONLY] — image / OCR behavior not controlled by .env
# (change core/scanner.py or related code if you need different values)
# =============================================================================
#
# DEBUG_SAVE_VARIANTS        True  — gated by DEBUG_ACTIVATE; no env toggle today.
# CLAHE tile grid              8×8  — all createCLAHE(...) calls in scanner.
# _sharpen_for_ocr median k    5    — blur kernel for variant unsharp.
# v3 median pre-blur           3    — when OCR_USE_V3_BASE on.
# Passport alignment box       PASSPORT_RECT_W×H = 1040×640 (constants in scanner).
# Card alignment box           RECT_W×RECT_H = 560×400.
# Default camera request size  CAMERA_WIDTH×HEIGHT = 1920×1080 (capture only).
# Variant count for OCR        5 images (v1, sharp, gray, v5 LAB CLAHE, v6 LAB CLAHE).
# EasyOCR reader language      ["en"] hardcoded.
#
# Tuner scripts (camera_adjustment/) read the same SCAN_* / ADJUST_* names for defaults.
# Slider order matches this file (see _tuner_trackbars.py):
#   adjust_thresholds.py  → 01–06 alignment + 07 SCAN_CLAHE_MASTER_CLIP + 08 SHARPNESS_THRESHOLD
#   adjust_variants.py      → 01–06 alignment + 07–10 variant OCR (no master / no poll threshold)
# Press 'q' in either tool to print a copy-paste .env block.
# =============================================================================


# --- Supabase (app sync; not image processing) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=

# --- NFC serial (hardware; not image processing) ---
# NFC_SERIAL_PORT=COM3

# --- ESP32 passport lights (HTTP /guide/on, /guide/off, /on, /off on device; optional) ---
# Set IP to enable: guide turns on while waiting for passport, turns off before flash,
# flash turns on 250ms before passport capture and off when the camera is released.
# ESP32_FLASH_IP=10.161.23.195
# (alias) ESP32_IP=10.161.23.195
